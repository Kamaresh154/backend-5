# ─────────────────────────────────────────────────────────
#  KidzVenture ERP — Backend Environment (SQLite / Dev Mode)
#  Place this file at:  backend/.env
# ─────────────────────────────────────────────────────────

# Use SQLite (no PostgreSQL needed for local/client deployment)
DEV_SQLITE=true
SQLITE_PATH=./kidzventure_dev.db

# IMPORTANT: Change this secret to a random string before sharing!
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-ME-use-python-secrets-token-hex-32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DEBUG=false

# Frontend URL — change if frontend runs on a different port/domain
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
